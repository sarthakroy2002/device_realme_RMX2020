cc_binary {
    name: "vendor.lineage.touch-service.RMX2020",
    init_rc: ["vendor.lineage.touch-service.RMX2020.rc"],
    vintf_fragments: ["vendor.lineage.touch-service.RMX2020.xml"],
    relative_install_path: "hw",
    srcs: [
        "TouchscreenGesture.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libutils",
        "vendor.lineage.touch-V1-ndk",
    ],
    proprietary: true,
}
