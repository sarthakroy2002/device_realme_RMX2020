    },
    target: {
        android_arm: {
            srcs: ["android.hardware.common-V2-ndk_platform.so"],
        },
    },
    compile_multilib: "32",
    check_elf_files: false,
    vendor: true,
}

cc_prebuilt_library_shared {
    name: "android.hardware.common-V2-ndk_platform-v32",
